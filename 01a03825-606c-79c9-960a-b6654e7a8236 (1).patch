+-- FusionEffectsClient : effets locaux des fusions critique et dorée.
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local TweenService = game:GetService("TweenService")
+
+local forgeEvent = ReplicatedStorage:WaitForChild("ForgeEvent")
+local gui = Instance.new("ScreenGui")
+gui.Name = "FusionEffectsGui"
+gui.ResetOnSpawn = false
+gui.DisplayOrder = 30
+gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
+
+local flash = Instance.new("Frame")
+flash.Size = UDim2.fromScale(1, 1)
+flash.BackgroundTransparency = 1
+flash.BorderSizePixel = 0
+flash.Parent = gui
+
+local message = Instance.new("TextLabel")
+message.AnchorPoint = Vector2.new(0.5, 0.5)
+message.Position = UDim2.fromScale(0.5, 0.35)
+message.Size = UDim2.fromOffset(700, 100)
+message.BackgroundTransparency = 1
+message.Font = Enum.Font.GothamBlack
+message.TextScaled = true
+message.TextStrokeTransparency = 0.25
+message.Visible = false
+message.Parent = gui
+
+local function showEffect(kind)
+	local golden = kind == "golden"
+	local color = golden and Color3.fromRGB(255, 210, 60) or Color3.fromRGB(255, 230, 100)
+	message.Text = golden and "✨ FUSION DORÉE !" or "⚡ FUSION CRITIQUE !"
+	message.TextColor3 = color
+	message.Visible = true
+	flash.BackgroundColor3 = color
+	flash.BackgroundTransparency = 0.55
+
+	-- Petit tremblement visuel de l'annonce.
+	for _ = 1, 5 do
+		message.Position = UDim2.fromScale(0.5 + math.random(-12, 12) / 1000, 0.35)
+		task.wait(0.04)
+	end
+	message.Position = UDim2.fromScale(0.5, 0.35)
+
+	TweenService:Create(flash, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
+	task.wait(1.2)
+	message.Visible = false
+end
+
+forgeEvent.OnClientEvent:Connect(function(action, data)
+	if action == "ForgeResult" and data and (data.type == "critical" or data.type == "golden") then
+		showEffect(data.type)
+	end
+end)
