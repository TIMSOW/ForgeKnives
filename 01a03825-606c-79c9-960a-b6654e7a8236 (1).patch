+--[[
+	PerfectStrikeClient (LocalScript)
+	Emplacement : StarterPlayer > StarterPlayerScripts > PerfectStrikeClient
+
+	Mini-jeu de l'étape 2 : le curseur se déplace continuellement.
+	Le joueur clique, tape ou appuie sur E pour frapper.
+--]]
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local RunService = game:GetService("RunService")
+local UserInputService = game:GetService("UserInputService")
+
+local forgeEvent = ReplicatedStorage:WaitForChild("ForgeEvent")
+local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
+
+local actif = false
+local depart = 0
+local connexionAnimation = nil
+
+local gui = Instance.new("ScreenGui")
+gui.Name = "PerfectStrikeGui"
+gui.ResetOnSpawn = false
+gui.DisplayOrder = 20
+gui.Enabled = false
+gui.Parent = playerGui
+
+local panneau = Instance.new("Frame")
+panneau.AnchorPoint = Vector2.new(0.5, 0.5)
+panneau.Position = UDim2.fromScale(0.5, 0.72)
+panneau.Size = UDim2.fromOffset(560, 170)
+panneau.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
+panneau.BorderSizePixel = 0
+panneau.Parent = gui
+
+local coins = Instance.new("UICorner")
+coins.CornerRadius = UDim.new(0, 12)
+coins.Parent = panneau
+
+local titre = Instance.new("TextLabel")
+titre.Size = UDim2.new(1, 0, 0, 42)
+titre.BackgroundTransparency = 1
+titre.Font = Enum.Font.GothamBold
+titre.Text = "FRAPPE L'ENCLUME !"
+titre.TextColor3 = Color3.fromRGB(255, 220, 150)
+titre.TextSize = 24
+titre.Parent = panneau
+
+local barre = Instance.new("Frame")
+barre.AnchorPoint = Vector2.new(0.5, 0)
+barre.Position = UDim2.new(0.5, 0, 0, 58)
+barre.Size = UDim2.fromOffset(480, 44)
+barre.BackgroundColor3 = Color3.fromRGB(55, 55, 66)
+barre.BorderSizePixel = 0
+barre.Parent = panneau
+
+local coinsBarre = Instance.new("UICorner")
+coinsBarre.CornerRadius = UDim.new(0, 8)
+coinsBarre.Parent = barre
+
+-- Zone "Bien" : 30 % de la largeur, au centre.
+local zoneBien = Instance.new("Frame")
+zoneBien.AnchorPoint = Vector2.new(0.5, 0.5)
+zoneBien.Position = UDim2.fromScale(0.5, 0.5)
+zoneBien.Size = UDim2.fromScale(0.30, 0.82)
+zoneBien.BackgroundColor3 = Color3.fromRGB(80, 160, 100)
+zoneBien.BorderSizePixel = 0
+zoneBien.Parent = barre
+
+local coinsBien = Instance.new("UICorner")
+coinsBien.CornerRadius = UDim.new(0, 6)
+coinsBien.Parent = zoneBien
+
+-- Zone "Parfait" : 15 % de la largeur, exactement au centre.
+local zoneParfaite = Instance.new("Frame")
+zoneParfaite.AnchorPoint = Vector2.new(0.5, 0.5)
+zoneParfaite.Position = UDim2.fromScale(0.5, 0.5)
+zoneParfaite.Size = UDim2.fromScale(0.15, 0.82)
+zoneParfaite.BackgroundColor3 = Color3.fromRGB(255, 205, 70)
+zoneParfaite.BorderSizePixel = 0
+zoneParfaite.Parent = barre
+
+local coinsParfait = Instance.new("UICorner")
+coinsParfait.CornerRadius = UDim.new(0, 6)
+coinsParfait.Parent = zoneParfaite
+
+local curseur = Instance.new("Frame")
+curseur.AnchorPoint = Vector2.new(0.5, 0.5)
+curseur.Position = UDim2.fromScale(0, 0.5)
+curseur.Size = UDim2.fromOffset(10, 54)
+curseur.BackgroundColor3 = Color3.fromRGB(245, 245, 255)
+curseur.BorderSizePixel = 0
+curseur.Parent = barre
+
+local coinsCurseur = Instance.new("UICorner")
+coinsCurseur.CornerRadius = UDim.new(0, 4)
+coinsCurseur.Parent = curseur
+
+local instruction = Instance.new("TextLabel")
+instruction.Position = UDim2.new(0, 0, 0, 112)
+instruction.Size = UDim2.new(1, 0, 0, 42)
+instruction.BackgroundTransparency = 1
+instruction.Font = Enum.Font.GothamMedium
+instruction.Text = "Clique, tape ou appuie sur E dans la zone dorée : +15 %"
+instruction.TextColor3 = Color3.fromRGB(220, 220, 230)
+instruction.TextSize = 16
+instruction.Parent = panneau
+
+local function fermer()
+	actif = false
+	gui.Enabled = false
+	if connexionAnimation then
+		connexionAnimation:Disconnect()
+		connexionAnimation = nil
+	end
+end
+
+-- Tier actuellement envoyé par le serveur au démarrage du mini-jeu.
+local tierEnCours = nil
+
+local function envoyerFrappe()
+	if not actif then
+		return
+	end
+
+	local temps = os.clock() - depart
+	local position = (math.sin(temps * 4) + 1) / 2
+	local distanceCentre = math.abs(position - 0.5)
+	local bonus = 0
+
+	if distanceCentre <= 0.075 then
+		bonus = 0.15
+	elseif distanceCentre <= 0.15 then
+		bonus = 0.05
+	end
+
+	fermer()
+	forgeEvent:FireServer("StrikeResult", tierEnCours, bonus)
+end
+
+barre.InputBegan:Connect(function(input)
+	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
+		envoyerFrappe()
+	end
+end)
+
+UserInputService.InputBegan:Connect(function(input, traiteParJeu)
+	if traiteParJeu or not actif then
+		return
+	end
+
+	if input.KeyCode == Enum.KeyCode.E or input.UserInputType == Enum.UserInputType.MouseButton1 then
+		envoyerFrappe()
+	end
+end)
+
+forgeEvent.OnClientEvent:Connect(function(action, donnees)
+	if action == "StartStrike" then
+		tierEnCours = donnees
+		actif = true
+		depart = os.clock()
+		gui.Enabled = true
+
+		if connexionAnimation then
+			connexionAnimation:Disconnect()
+		end
+
+		connexionAnimation = RunService.RenderStepped:Connect(function()
+			if actif then
+				local position = (math.sin((os.clock() - depart) * 4) + 1) / 2
+				curseur.Position = UDim2.fromScale(position, 0.5)
+			end
+		end)
+
+	elseif action == "StrikeCancelled" then
+		fermer()
+	end
+end)
